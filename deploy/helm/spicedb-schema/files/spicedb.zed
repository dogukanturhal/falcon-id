    permission material_delete = manage
    permission material_issue = edit

    // Projeler (RPM WP-22, spec 22 §8): the PM permission module key moved pm -> projects, so these are the checks on module:<tenant>/projects.
    // Only names that no other module uses are aliased here; the shared names (workflows_/templates_ read/create/update/delete, billing_read,
    // reports_read, dashboard_read, import_*) stay as they are. Read -> view, work on tasks/sprints/resources -> edit; money (budget/cost/rates/
