    // Proje Yönetimi (pm) rates (R-PM WP-12): pm:rates:manage gates resource-rate writes AND whether hourly cost/bill
    // amounts are returned at all (business SpiceDbRateVisibility checks this name with no module-level fallback, so
    // without it every caller gets amounts stripped). Manage-level: rates are salary-adjacent, members/externals never see them.
    permission rates_manage = manage

    // Proje Yönetimi (pm) RPM-B3: pm:billing:approve releases a fixed-price billing milestone before its deliverable is done;
    // pm:time_tracking:approve decides other people's weekly timesheets (never one's own, enforced in business); pm:risks:* is the
    // project risk/issue register (WP-20). Approvals are manage-level, the register follows the usual view/edit/manage split.
    permission billing_approve = manage
    permission time_tracking_approve = manage
