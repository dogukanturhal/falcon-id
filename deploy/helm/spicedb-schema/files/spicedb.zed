/**
 * AccessGrant - Fine-grained permission/grant definition
 * Format: module:resource:action (e.g., crm:contacts:create)
 * Note: Named "access_grant" because "permission" is a reserved keyword in SpiceDB
 */
definition access_grant {
    // Which tenant this grant belongs to
    relation tenant: tenant

    // Roles that have this grant
    relation granted_to: role#member | user
    relation granted_to_role: role

    // Check if user has this grant
    permission check = granted_to + granted_to_role->member + tenant->admin
}

/**
 * Document - Generic resource for fine-grained access control
 * Can represent invoices, contracts, reports, etc.
 */
definition document {
    // Which tenant this document belongs to
    relation tenant: tenant

    // Document ownership and access
    relation owner: user
    relation editor: user | group#member | role#member
    relation viewer: user | group#member | role#member
    relation approver: user | role#member

    // Parent folder/container for inheritance
    relation parent: folder

    // Computed permissions
    permission view = owner + editor + viewer + approver + tenant->admin + parent->view
    permission edit = owner + editor + tenant->admin + parent->edit
    permission delete = owner + tenant->admin + parent->delete
    permission approve = owner + approver + tenant->admin
    permission share = owner + tenant->admin
}

/**
 * Folder - Container for documents with inherited permissions
 */
definition folder {
    // Which tenant this folder belongs to
    relation tenant: tenant

    // Folder access
    relation owner: user
    relation editor: user | group#member | role#member
    relation viewer: user | group#member | role#member

    // Parent folder for hierarchy
    relation parent: folder

    // Computed permissions
    permission view = owner + editor + viewer + tenant->admin + parent->view
    permission edit = owner + editor + tenant->admin + parent->edit
    permission delete = owner + tenant->admin + parent->delete
    permission create_document = owner + editor + tenant->admin + parent->create_document
}

/**
 * API Key - Service account or API key authorization
 */
definition api_key {
    // Which tenant this API key belongs to
    relation tenant: tenant

    // Owner of the API key
    relation owner: user

    // Scoped permissions (what the API key can do)
    relation scope: access_grant

    // Computed permissions
    permission use = owner
    permission revoke = owner + tenant->admin
    permission view = owner + tenant->admin
}

/**
 * Session - User session for session-based authorization
 */
definition session {
    // Which tenant this session belongs to
    relation tenant: tenant

    // Session owner
    relation owner: user

    // Impersonator (if session is impersonated)
    relation impersonator: user

    // Computed permissions
    permission use = owner + impersonator
    permission revoke = owner + impersonator + tenant->admin
}

// ============================================================================
// ERP Module-Specific Resources
// ============================================================================

/**
 * CRM Resources
 */
definition crm_contact {
    relation tenant: tenant
    relation owner: user
    relation assigned_to: user
    relation viewer: user | group#member | role#member

    permission view = owner + assigned_to + viewer + tenant->admin
    permission edit = owner + assigned_to + tenant->admin
    permission delete = owner + tenant->admin
}

definition crm_company {
    relation tenant: tenant
    relation owner: user
    relation account_manager: user
    relation viewer: user | group#member | role#member

    permission view = owner + account_manager + viewer + tenant->admin
    permission edit = owner + account_manager + tenant->admin
    permission delete = owner + tenant->admin
}

definition crm_opportunity {
    relation tenant: tenant
    relation owner: user
    relation sales_rep: user
    relation viewer: user | group#member | role#member

    permission view = owner + sales_rep + viewer + tenant->admin
    permission edit = owner + sales_rep + tenant->admin
    permission delete = owner + tenant->admin
    permission close = owner + sales_rep + tenant->admin
}

/**
 * Finance Resources
 */
definition invoice {
    relation tenant: tenant
    relation creator: user
    relation approver: user | role#member | user with approval_limit
    relation viewer: user | group#member | role#member
    relation company: company
    relation record_open: user:* with record_not_locked

    permission view = creator + approver + viewer + tenant->admin
    permission edit = creator + tenant->admin
    permission delete = creator + tenant->admin
    permission approve = approver + tenant->admin
    permission void = tenant->admin

    // NEW (R2 WP-02) - record-lock-gated variants (spec 23 section 4.3).
    // `record_open` must hold a `user:*` tuple carrying the
    // `record_not_locked` caveat for the record; callers pass
    // `record_status` at Check time. No tuple, or a posted/locked status,
    // denies; a missing `record_status` is CONDITIONAL (treated as denied).
    permission edit_unlocked = edit & record_open
    permission approve_unlocked = approve & record_open
}

definition payment {
    relation tenant: tenant
    relation creator: user
    relation approver: user | role#member | user with approval_limit
    relation company: company
    relation record_open: user:* with record_not_locked

    permission view = creator + approver + tenant->admin
    permission edit = creator + tenant->admin
    permission approve = approver + tenant->admin
    permission process = approver + tenant->admin

    // NEW (R2 WP-02) - see invoice.record_open.
    permission edit_unlocked = edit & record_open
    permission approve_unlocked = approve & record_open
}

/**
 * HR Resources
 */
definition employee {
    relation tenant: tenant
    relation self: user
    relation manager: user
    relation hr_admin: user | role#member
    // hr_admin_sensitive: separate grant for salary/PII-level HR data
    // (EmployeeRelationshipService.GrantHRAdminAccessAsync writes this
    // alongside hr_admin as a distinct, narrower relation -- t-582)
    relation hr_admin_sensitive: user | role#member
    // payroll_officer: bordro uzmanı / SMMM; reads payroll amounts without the
    // broader PII grant of hr_admin_sensitive (R-HR WP-09)
    relation payroll_officer: user | role#member

    permission view_basic = self + manager + hr_admin + hr_admin_sensitive + tenant->admin
    permission view_sensitive = self + hr_admin_sensitive + tenant->admin
    permission view_payroll = self + payroll_officer + hr_admin_sensitive + tenant->admin
    permission edit = hr_admin + hr_admin_sensitive + tenant->admin
    permission terminate = tenant->admin
    // line manager or HR approves leave (R-HR WP-10); self-approval is refused in the HR service
    permission approve_leave = manager + hr_admin + hr_admin_sensitive + tenant->admin
  // performance management (HR KPI plan WP-P0a): employee sees own released
  // scorecard, line manager reviews, HR calibrates; mirrors approve_leave shape
  permission view_performance = self + manager + hr_admin + hr_admin_sensitive + tenant->admin
  permission review_performance = manager + hr_admin + hr_admin_sensitive + tenant->admin
  permission calibrate_performance = hr_admin + hr_admin_sensitive + tenant->admin
}

/**
 * Payroll run (R-HR WP-20): per-run segregation of duties. The calculator and
 * the last adjuster are excluded by approve/reject. approve_any establishes
 * permission before the business sole-approver guard applies compensating
 * controls; it is not itself an authorization to bypass SoD.
 */
definition payroll_run {
    relation tenant: tenant
    relation calculator: user
    relation last_adjuster: user
    relation approver: user | role#member

    permission view = approver + calculator + tenant->admin
    permission approve_any = approver + tenant->admin
    permission approve = approve_any - calculator - last_adjuster
    permission reject = approve
}

/**
 * Project Management Resources
 */
// project.manager/viewer/external_contributor relations are written by the business PM module's ProjectRelationMap
// (ProjectMemberService, TeamMemberAddedEventHandler): Lead -> owner, Manager -> manager, Contributor/Reviewer -> member,
// Observer -> viewer, ExternalContributor -> external_contributor (RPM WP-22). Only assignee + the project pointer are ever
// written on task (t-582 audit: TaskAssignedEventHandler, TaskCreatedEventHandler). Business SpiceDB writes are no-ops in
// shadow mode, so no live tuples exist until enforcement is switched on (the backfill must use ProjectRelationMap).
definition project {
    relation tenant: tenant
    relation owner: user
    relation manager: user
    relation member: user
    relation viewer: user
    relation external_contributor: user

    permission view = owner + manager + member + viewer + tenant->admin
    permission edit = owner + manager + tenant->admin
    permission delete = owner + tenant->admin
    permission manage_members = owner + manager + tenant->admin
    // Budget/cost/rate fields of this project: never member, viewer or external_contributor.
    permission view_financials = owner + manager + tenant->admin
    // Time may be booked by the people doing the work, including an external contributor (who cannot otherwise view the project).
    permission log_time = owner + manager + member + external_contributor
}

definition task {
    relation tenant: tenant
    relation project: project
    relation assignee: user

    permission view = assignee + project->view
    permission edit = assignee + project->edit
    permission delete = project->edit
    permission complete = assignee + project->edit
}

/**
 * Inventory Resources
 */
// warehouse.manager/staff and product.editor/viewer narrowed to plain
// `user` -- t-582 writer audit (WarehousePermissionService) confirmed
// these are only ever written as bare user subjects; product.editor/
// viewer are never written by any code path (product.owner is the only
// real grant), so those two relations are dropped rather than left
// declared-but-unpopulated.
definition warehouse {
    relation tenant: tenant
    relation manager: user
    relation staff: user

    permission view = manager + staff + tenant->admin
    permission manage_inventory = manager + tenant->admin
    permission transfer = manager + staff + tenant->admin
}

definition product {
    relation tenant: tenant
    relation owner: user

    permission view = owner + tenant->admin
    permission edit = owner + tenant->admin
    permission delete = owner + tenant->admin
}

/**
 * E-Commerce Resources
 */
definition ecommerce_product {
    relation tenant: tenant
    relation owner: user
    relation editor: user | role#member
    relation viewer: user | group#member | role#member

    permission view = owner + editor + viewer + tenant->admin
    permission edit = owner + editor + tenant->admin
    permission delete = owner + tenant->admin
}

definition ecommerce_customer {
    relation tenant: tenant
    relation owner: user
    relation editor: user | role#member
    relation viewer: user | group#member | role#member

    permission view = owner + editor + viewer + tenant->admin
    permission edit = owner + editor + tenant->admin
    permission delete = owner + tenant->admin
}

definition ecommerce_order {
    relation tenant: tenant
    relation owner: user
    relation editor: user | role#member
    relation viewer: user | group#member | role#member

    permission view = owner + editor + viewer + tenant->admin
    permission edit = owner + editor + tenant->admin
    permission delete = owner + tenant->admin
}

definition ecommerce_category {
    relation tenant: tenant
    relation owner: user
    relation editor: user | role#member
    relation viewer: user | group#member | role#member

    permission view = owner + editor + viewer + tenant->admin
    permission edit = owner + editor + tenant->admin
    permission delete = owner + tenant->admin
}

// ============================================================================
// ERP Module-Specific Resources, part 2 (write-verified, t-582)
//
// Every relation below is scoped to a resourceType that has at least one
// confirmed ISpiceDbClient.WriteRelationshipAsync / BulkWriteRelationshipsAsync
// call site in src/Modules/**. Relations NOT written anywhere by real code
// are intentionally omitted (see t-582 research notes) rather than invented.
//
// Subject-type note: role-sourced grants below (`approver`, vendor.viewer)
// use bare `role` (not `role#member`). RelationshipUpdate.Create's optional
// subjectRelation argument is never passed at any of these call sites, so
// the tuples business actually writes are bare `role:<id>` object
// references, not `role:<id>#member` usersets -- declaring `role#member`
// here would make WriteRelationship reject every one of them as a type
// mismatch. This differs from the module/document/folder/warehouse-style
// relations elsewhere in this file, which use full `role#member` usersets
// via a different, independently-verified call path.
// ============================================================================

/**
 * MM (Materials Management) Resources
 */
definition purchase_order {
    relation tenant: tenant
    relation creator: user
    relation approver: user | role
    relation receiver: user

    permission view = creator + receiver + approver + tenant->admin
    permission edit = creator + tenant->admin
    permission approve = approver + tenant->admin
    permission receive = receiver + tenant->admin
}

definition material {
    relation tenant: tenant
    relation creator: user

    permission view = creator + tenant->admin
    permission edit = creator + tenant->admin
}

/**
 * vendor is written from two independent modules: MM
 * (SpiceDbRelationshipService, `creator`) and Finance
 * (FinanceAuthorizationService, `creator` again + `viewer` role-scoped
 * to "finance_user"). Both are unioned here rather than split.
 */
definition vendor {
    relation tenant: tenant
    relation creator: user
    relation viewer: user | role

    permission view = creator + viewer + tenant->admin
    permission edit = creator + tenant->admin
}

/**
 * Finance Resources (write-verified)
 */
definition bill {
    relation tenant: tenant
    relation creator: user
    relation viewer: user
    relation editor: user
    relation approver: user | role | user with approval_limit
    relation company: company
    relation record_open: user:* with record_not_locked

    permission view = creator + viewer + editor + approver + tenant->admin
    permission edit = creator + editor + tenant->admin
    permission approve = approver + tenant->admin

    // NEW (R2 WP-02) - see invoice.record_open.
    permission edit_unlocked = edit & record_open
    permission approve_unlocked = approve & record_open
}

definition expense_report {
    relation tenant: tenant
    relation owner: user
    relation viewer: user
    relation editor: user
    relation approver: user | role | user with approval_limit
    relation company: company
    relation record_open: user:* with record_not_locked

    permission view = owner + viewer + editor + approver + tenant->admin
    permission edit = owner + editor + tenant->admin
    permission approve = approver + tenant->admin

    // NEW (R2 WP-02) - see invoice.record_open.
    permission edit_unlocked = edit & record_open
    permission approve_unlocked = approve & record_open
}

/**
 * FICO (Financial Controlling) Resources
 */
definition cost_center {
    relation tenant: tenant
    relation manager: user
    relation viewer: user
    relation editor: user

    permission view = manager + viewer + editor + tenant->admin
    permission edit = manager + editor + tenant->admin
    permission manage = manager + tenant->admin
}

definition budget {
    relation tenant: tenant
    relation approver: user | role

    permission view = approver + tenant->admin
    permission approve = approver + tenant->admin
}

definition fixed_asset {
    relation tenant: tenant
    relation custodian: user
    // Pointer relation: assigned_to references the owning cost_center
    // object directly (arrow traversal), not a usual per-user grant --
    // written only when a cost center is assigned to the asset.
    relation assigned_to: cost_center

    permission view = custodian + assigned_to->view + tenant->admin
    permission edit = custodian + tenant->admin
}

definition profit_center {
    relation tenant: tenant
    relation manager: user

    permission view = manager + tenant->admin
    permission edit = manager + tenant->admin
}

/**
 * PPSCM (Production Planning & Supply Chain) Resources
 */
definition production_order {
    relation tenant: tenant
    relation operator: user
    // R6 WP-22: the planner who owns the order (Üretim Planlamacı) edits it without being a shop-floor operator.
    relation planner: user

    permission view = operator + planner + tenant->admin
    permission edit = operator + planner + tenant->admin
}

/**
 * R6 WP-22 / D16: a work center and the users operating it. Kiosk (Operatör) confirmations are checked against the work center of the
 * operation (the actual work center when the confirmation names one): `confirm = operator + tenant->admin`. Supervisors, engineers and
 * legacy module editors confirm anywhere through the module-level shop_floor_confirm_any / edit grants, not through this relation.
 */
definition work_center {
    relation tenant: tenant
    relation operator: user

    permission confirm = operator + tenant->admin
}

/**
 * quality_gate and production_scrap are both checked
 * ([RequireResourcePermission]) AND written, unlike the rest of this
 * section -- permissions below mirror the exact checked-permission
 * strings from QualityGatesController / ProductionScrapController.
 */
definition quality_gate {
    relation tenant: tenant
    relation creator: user
    relation approver: user | role

    permission view = creator + approver + tenant->admin
    permission complete = creator + tenant->admin
    permission approve = approver + tenant->admin
}

definition production_scrap {
    relation tenant: tenant
    relation creator: user
    relation disposer: user | role

    permission view = creator + disposer + tenant->admin
    permission dispose = disposer + tenant->admin
}

/**
 * SD (Sales & Distribution) Resources
 */
definition sales_order {
    relation tenant: tenant
    relation sales_rep: user
    relation approver: user | role
    relation approved_by: user

    permission view = sales_rep + approver + approved_by + tenant->admin
    permission edit = sales_rep + tenant->admin
    permission approve = approver + tenant->admin
    permission allocate = sales_rep + approved_by + tenant->admin
}

definition delivery {
    relation tenant: tenant
    relation assigned_to: user

    permission view = assigned_to + tenant->admin
    permission edit = assigned_to + tenant->admin
}

/**
 * CRM Resources, part 2
 *
 * crm_pipeline is the ONLY domain entity in the codebase driven by the
 * generic IAuthorizableEntity/SpiceDbSaveChangesInterceptor mechanism
 * (Pipeline : IOwnedEntity, ICreatorTrackedEntity) in addition to its
 * own explicit PipelinePermissionService writes -- it gets `owner` +
 * `creator` from the interceptor, and `viewer`/`editor`/`owner` again
 * from AccessLevelToRelation (view/edit/admin). Checked permissions
 * confirmed via PipelinesController are "edit" and "delete"; "view" is
 * inferred from the viewer relation's existence and is not itself a
 * confirmed checked shape.
 */
definition crm_pipeline {
    relation tenant: tenant
    relation owner: user
    relation creator: user
    relation viewer: user | role
    relation editor: user | role

    permission view = owner + creator + viewer + editor + tenant->admin
    permission edit = owner + editor + tenant->admin
    permission delete = owner + tenant->admin
}

// ============================================================================
// Application Object & Service Principal (Entra ID-inspired)
// ============================================================================

/**
 * Application - Global application definition registered on the platform.
 * Equivalent to Entra ID "Application Object" — a blueprint that can be
 * instantiated per-tenant via a Service Principal.
 */
definition application {
    // The tenant that owns / published this application
    relation owner: tenant

    // Tenants that have granted admin consent to install this application
    relation consented_tenant: tenant

    // Management: only admins of the owning tenant
    permission manage = owner->admin

    // Installation: consented tenant admins or owning tenant admins
    permission install = consented_tenant->admin + owner->admin

    // Viewing: members of consented tenants or the owning tenant
    permission view = consented_tenant->member + owner->member
}

/**
 * Service Principal - Per-tenant instantiation of an Application.
 * Equivalent to Entra ID "Service Principal" — represents an app's identity
 * and permissions within a specific tenant.
 */
definition service_principal {
    // Which application this SP was instantiated from
    relation application: application

    // Which tenant this SP is installed in
    relation tenant: tenant

    // The user who provisioned / owns this SP
    relation owner: user

    // Use: tenant members who can also view the application
    permission use = tenant->member & application->view

    // Management: tenant admins
    permission manage = tenant->admin

    // View: any member of the tenant
    permission view = tenant->member
}

// ============================================================================
// Platform Product & Instance Resources (Multi-Product Architecture)
// ============================================================================

/**
 * Platform Product - A product registered on the HexxLock platform
 * (e.g., ExampleSuite, Example PMS, Car Rental, Travel Agency).
 * Tracks which tenants are subscribed to which products.
 */
definition platform_product {
    // The tenant that owns/published this product
    relation owner: tenant

    // Tenants that have an active subscription to this product
    relation subscribed_tenant: tenant

    // Access: subscribed tenants and the owning tenant
    permission access = subscribed_tenant + owner

    // Management: only admins of the owning tenant
    permission manage = owner->admin
}

/**
 * Product Instance - A provisioned instance of a product for a specific tenant.
 * Tracks the provisioning lifecycle and authorization for product usage.
 */
definition platform_product_instance {
    // Which product this instance belongs to
    relation product: platform_product

    // Which tenant this instance is provisioned for
    relation tenant: tenant

    // The user who triggered the provisioning
    relation provisioner: user

    // Use: tenant members who have product access
    permission use = tenant->member & product->access
    permission admin = tenant->admin & product->access
    permission view = tenant->view & product->access
}

/**
 * Talon IAP route — per-route ReBAC for *.internal.example.com admin tier.
 *
 * This is the cluster's single SoR for the schema (see the file header),
 * applied by the dedicated `spicedb-schema` Argo CD Application — NOT by
 * falcon-id's own chart, and NOT by Talon. Talon — the IAP at
 * talon.svc.cluster.local, sole IAP for every *.internal.example.com host —
 * owns and writes `talon_route` RELATIONSHIPS at runtime via the
 * TalonRoute CRD reconciler (talon/internal/policy/spicedb.go); it only
 * READS this schema at startup to verify the definition is live
 * (talon/internal/spicedb/client.go EnsureSchema, since t-582 — Talon no
 * longer calls WriteSchema itself). Because SpiceDB's `WriteSchema` API
 * REPLACES the entire schema, omitting this definition would drop it on
 * the next apply of this chart — SpiceDB then refuses the drop because
 * Talon's live relationships still reference it, wedging this
 * Application's schema-write hook (production trace 2026-04-28:
 * schema-write Job crashlooped with "cannot delete object definition
 * `talon_route`, as a relationship exists under it" until this
 * definition was added to the union).
 *
 * Definition shape is byte-identical to Talon's own former copy
 * (deleted from talon/internal/spicedb/schema.zed as part of t-582 —
 * this file is now the ONLY copy). Talon writes the `viewer` / `editor`
 * / `admin` relations from the TalonRoute reconciler.
 */
definition talon_route {
    relation viewer: user | group#member
    relation editor: user | group#member
    relation admin:  user | group#member

    permission access = viewer + editor + admin
    permission write  = editor + admin
    permission manage = admin
}

/**
 * active_elevation - R1 platform-plane JIT elevation + break-glass caveat
 * (the product specification §12.3/§12.4,
 * 23-authorization-rbac-abac-rebac.md §4.3).
 *
 * Attached to every hxl_platform relationship written for a time-bound
 * grant (JIT elevation activation and break-glass self-grant). `now` is
 * supplied by the caller (falcon-id) at CHECK time via
 * CheckPermissionRequest.Context, never trusted from the relationship
 * write itself, so a grant that outlives its own expires_at stops passing
 * checks the instant `now` crosses it - no separate delete is required
 * for the permission check to fail-closed; the auto-revoke sweep
 * (internal/services/platform_jit_service.go) still deletes the
 * relationship afterwards so ListRelationships / audits don't show a
 * phantom grant forever.
 *
 * Caveats in the schema: this one, entitlement_window, and (R2 WP-02)
 * approval_limit + record_not_locked (end of file). The rest of the
 * 23-authorization... §4.3 catalog - branch_scope,
 * sensitive_access_window, mfa_fresh - has no confirmed writer yet per the
 * t-582 survey discipline at the top of this file; deliberately NOT added
 * until a real call site exists.
 * authzed-go v1.8.0 (already vendored, see go.mod) supports
 * ContextualizedCaveat/OptionalCaveat on WriteRelationships and Context on
 * CheckPermission, so caveats are usable today despite the roadmap's
 * "zero caveats live" baseline being written before this change.
 */
caveat active_elevation(now timestamp, expires_at timestamp) {
  now < expires_at
}

/**
 * entitlement_window - bounds an `entitled_module` tuple to the entitlement's
 * end date (trial end, grace end, current period end). Same CEL shape as
 * `active_elevation`; kept as a separate caveat so entitlement and elevation
 * semantics can diverge. Callers pass `now` as check-time context; a check
 * without `now` is CONDITIONAL, which falcon-id treats as not entitled.
 */
caveat entitlement_window(now timestamp, expires_at timestamp) {
  now < expires_at
}

/**
 * approval_limit - amount threshold on `approver: user with approval_limit`
 * (invoice, payment, bill, expense_report; spec 23 section 4.3). `amount` /
 * `currency` come from the document, `limit_amount` / `limit_currency` from
 * the approver's Postgres approval-limit row, all supplied as Check context
 * (never baked into the tuple), so changing a limit is a Postgres update.
 *
 * Currency mismatch is false (fail-closed, never a cross-currency
 * comparison); amount == limit passes. Any missing parameter makes the
 * check CONDITIONAL, which falcon-id treats as denied.
 *
 * DEVIATION from spec 23 section 4.3: the spec types amounts as `decimal`,
 * which is not a SpiceDB caveat type (valid: bool, string, int, uint, double,
 * bytes, duration, timestamp, list, map, ipaddress, any). `double` is used;
 * callers should send the decimal amount as a JSON number.
 */
caveat approval_limit(amount double, currency string, limit_amount double, limit_currency string) {
    currency == limit_currency && amount <= limit_amount
}

/**
 * record_not_locked - record-state gate on `record_open: user:* with
 * record_not_locked` (invoice, payment, bill, expense_report; spec 23
 * section 4.3). Belt-and-suspenders in front of the DB-level
 * `fn_forbid_mutate_posted` trigger. A missing `record_status` is
 * CONDITIONAL (denied). NOTE: this is a denylist and case-sensitive - any
 * status other than exactly "posted"/"locked" passes, so the PEP must send
 * the canonical lowercase status (R2 WP-16 decides allowlist vs denylist).
 */
caveat record_not_locked(record_status string) {
    record_status != "posted" && record_status != "locked"
}
