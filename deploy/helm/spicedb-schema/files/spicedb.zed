/**
 * Cluster SpiceDB schema — single source of record (t-582).
 *
 * OWNERSHIP (read this before editing)
 * =====================================
 * This file is applied by the `spicedb-schema` Argo CD Application
 * (<gitops-bootstrap-repo>: clusters/prod-eu-west-1-hub/addons/spicedb-schema.yaml,
 * chart: deploy/helm/spicedb-schema), which is independently synced and is
 * the ONLY writer of SpiceDB's schema in this cluster. It lives in this repo
 * for now (co-located with the ERP definitions it primarily serves) but is
 * NOT part of the falcon-id Helm release — falcon-id no longer ships a
 * schema-write hook of its own.
 *
 * SpiceDB's `WriteSchema` RPC has REPLACE, not merge, semantics: whatever
 * definition set is written here becomes the ENTIRE live schema, dropping
 * anything omitted. Prior to t-582 that was violated by three independent
 * writers hitting the same global SpiceDB instance (falcon-id's own PostSync
 * hook, Talon's PreSync hook, AND Talon's `EnsureSchema()` call at every pod
 * startup baked in via `//go:embed`), each REPLACING whatever the others had
 * written. Root-caused 2026-09-07/08: a Talon HPA scale-up event's fresh
 * pods called `EnsureSchema()` with Talon's own stale 3-definition embedded
 * copy at 19:55:08 UTC, silently reverting a full 45-definition schema write
 * that had landed 1h29m45s earlier. See board row t-582 for the full
 * incident writeup. Talon's own copy (talon/internal/spicedb/schema.zed) and
 * both PreSync/PostSync hooks (talon and falcon-id) have been deleted; Talon
 * now only READS the live schema at startup to verify its required
 * definitions (`user`, `group`, `talon_route`) are present — it never calls
 * `WriteSchema` again. This file MUST remain the union of every definition
 * any consumer needs (Talon's IAP routing + every business ERP resource
 * type) — never split it back across multiple writers.
 *
 * ExampleSuite IAM SpiceDB Schema
 *
 * This schema defines the authorization model for the ExampleSuite multi-tenant SaaS platform.
 * Based on Google Zanzibar's Relationship-Based Access Control (ReBAC) model.
 *
 * Key Concepts:
 * - Tenant isolation: All resources are scoped to a tenant
 * - Role-based: Users have roles, roles have permissions
 * - Hierarchical: Groups and organizations can inherit permissions
 * - Fine-grained: Support for resource-level permissions
 *
 * Object ID Format: {tenant_id}:{resource_id}
 * Example: "00000000-0000-0000-0000-000000000002:user123"
 *
 * t-582 scope note: every business-module definition in this file was
 * authored against a source-verified survey of business's real
 * ISpiceDbClient writers and [RequirePermission]/[RequireResourcePermission]
 * checks (see tools/t582-shapes.tsv and t-582 research notes in the
 * business repo), not invented. Checked resourceTypes with NO confirmed
 * writer anywhere in the codebase (allocation, capacity, capacity_plan,
 * all cmms_*, all plm_*, all qms_*, segment -- ~36 of the 44 checked
 * types) are deliberately NOT defined here; they are a business-process
 * gap (no code path populates them), not a schema-authoring omission,
 * and must not be modelled speculatively. crm_contact/crm_company/
 * crm_opportunity/invoice/payment/ecommerce_* predate t-582, have no
 * confirmed writer either, and are left as-is rather than removed.
 */

definition user {}

/**
 * hxl_platform - Hexxlock operator plane (platform plane, R1 JIT elevation +
 * break-glass; the product specification §12.3,
 * 23-authorization-rbac-abac-rebac.md §4.2).
 *
 * Named `hxl_platform`, NOT `platform`, to avoid colliding with the existing
 * `platform_product`/`platform_product_instance` multi-product catalog
 * objects defined below (different concept - product catalog, not operator
 * authority). There is exactly ONE hxl_platform object in the system,
 * `hxl_platform:hexxlock`, related to every `tenant` via the `platform`
 * relation added below; only relationships against THAT object ID are
 * meaningful (falcon-id's platform-role/JIT code never writes any other
 * hxl_platform object).
 *
 * Relation names mirror the iam_platform_roles.role_key enum values 1:1
 * (platform_admin -> admin, platform_support -> support, platform_billing
 * -> billing, platform_security -> security, platform_viewer -> viewer) so
 * the standing/JIT write path derives the SpiceDB relation straight from
 * the DB role_key with a fixed lookup table.
 */
definition hxl_platform {
    relation admin: user | user with active_elevation
    relation support: user | user with active_elevation
    relation billing: user | user with active_elevation
    relation security: user | user with active_elevation
    relation viewer: user | user with active_elevation
    // Console P0 (platform-admin console): two more JIT-only roles.
    relation compliance: user | user with active_elevation
    relation sre: user | user with active_elevation

    permission manage_identity = admin + security
    permission manage_billing_catalog = admin + billing
    permission support_diagnose = admin + support
    permission view = admin + support + billing + security + viewer + compliance + sre

    // Operator-console permissions (platform-admin console, P0). SpiceDB
    // permission names cannot contain ':', so ops_<domain>_<verb> here is
    // surfaced on the wire as ops:<domain>:<verb> (falcon-id's operator
    // token exchange maps one onto the other and emits them as the
    // `ops_perms` claim). Enforced by platform-shared/operatorauth in each
    // service; falcon-id is the only decision point.
    //
    // Reads (masked data only) - the standing viewer role carries these.
    permission ops_tenants_read = admin + support + billing + security + viewer + compliance + sre
    permission ops_users_read = admin + support + billing + security + viewer + compliance + sre
    permission ops_billing_read = admin + support + billing + security + viewer + compliance + sre
    permission ops_quota_read = admin + support + billing + security + viewer + compliance + sre
    permission ops_edoc_read = admin + support + billing + security + viewer + compliance + sre
    permission ops_system_read = admin + sre + viewer + support + billing + security + compliance
    permission ops_flags_read = admin + support + billing + security + viewer + compliance + sre
    permission ops_notify_read = admin + support + billing + security + viewer + compliance + sre
    permission ops_audit_read = admin + security + compliance
    // Writes (JIT-only roles).
    permission ops_tenants_write = admin + support
    permission ops_tenants_lifecycle = admin + sre
    permission ops_tenants_purge = admin
    permission ops_users_write = admin + support + security
    permission ops_pii_reveal = admin + support + security + compliance
    permission ops_billing_write = admin + billing
    permission ops_billing_refund = admin + billing
    // Payment-gateway settings (stored-card cap, per-tenant checkout settings): T2/T3, admin only.
    permission ops_payments_config = admin
    permission ops_catalog_write = admin + billing
    permission ops_quota_write = admin + billing
    // Quota tiers above the per-tenant T1 write: plan limits / registry
    // patches (every tenant on the plan) and the periodic reset (all tenants).
    // Both are T2 (step-up) in quota-service.
    permission ops_quota_plan = admin + billing
    permission ops_quota_reset = admin + billing
    permission ops_edoc_write = admin + billing
    permission ops_flags_write = admin + sre
    permission ops_notify_write = admin + sre
    permission ops_staff_manage = admin
    permission ops_audit_export = admin + security + compliance
}

/**
 * Tenant - Top-level isolation boundary
 * Every resource belongs to exactly one tenant
 */
definition tenant {
    // Direct relationships
    relation owner: user
    relation admin: user
    relation member: user

    // NEW (R3 guest; 23-authorization-rbac-abac-rebac.md section 4.2,
    // 17-module-account.md section 3.2) - external, seat-free member: an
    // accountant (SMMM) invited from their own partner tenant with
    // seat_class=external. Written by falcon-id's team invitation accept and
    // removed by external-member revoke (TenantBootstrapService.
    // SyncExternalAccess); the SpiceDB reconciler converges the member's
    // role edges from PostgreSQL but never this marker. Referenced by NO
    // permission (not view, not manage), so holding it grants nothing and a
    // stale edge is harmless. Everything the accountant can do comes from
    // tenant-scoped role grants assigned at accept: roles whose permissions
    // are all reads, plus the one write-like exception falcon-id admits for
    // external roles, preaccounting accountant-export create/retry
    // (LD-R3-GUEST-1; an export never changes the books). Removing those
    // role edges, not this marker, is what ends access.
    relation guest: user

    // NEW (R1 platform plane) - every tenant relates to the single
    // hxl_platform:hexxlock object. Lets any check answer "is this the
    // Platform-internal tenant" without a special-cased UUID comparison in
    // application code.
    relation platform: hxl_platform

    // NEW (R1 entitlements; 23-authorization-rbac-abac-rebac.md section 4.2) -
    // one relation per module the tenant is entitled to (status active /
    // trialing / grace in iam_tenant_module_entitlements). The permission
    // boundary (spec 23 section 5.1) reads
    // `tenant:<T>#entitled_module@module:<T>/<module_code>`; absence = not
    // entitled. Written/removed by falcon-id's entitlement sync
    // (pkg/spicedb/entitlement.go), never by hand. Tuples that carry an
    // end date (trial end, grace end, period end) use the
    // `entitlement_window` caveat so an entitlement stops passing checks the
    // instant it lapses even if the sync write is delayed.
    relation entitled_module: module | module with entitlement_window

    // Computed permissions
    permission manage = owner + admin
    permission view = owner + admin + member
    permission delete = owner

    // NEW (R1 platform plane) - true ONLY for the Platform-internal tenant
    // (00000000-0000-0000-0000-000000000002), i.e. only for the tenant
    // whose `platform: hxl_platform` relationship target holds
    // manage_identity. Backs the iam_platform_roles membership
    // CHECK/trigger's SpiceDB-side counterpart.
    permission is_platform_internal = platform->manage_identity
}

/**
 * role_assignment - a user's assignment of module-scoped roles inside one
 * tenant (23-authorization-rbac-abac-rebac.md section 4.2). Names the module
 * the permissions belong to so the write-time permission boundary (spec 23
 * section 5.1) has an enforcement point: falcon-id reads
 * `tenant#entitled_module@module` before writing `assigned`. Object id is
 * `<tenant_id>/<module_code>/<user_id>` (one object per user+module).
 */
definition role_assignment {
    relation tenant: tenant
    relation module: module
    relation assigned: user

    permission use = assigned
}

/**
 * company - legal entity (23-authorization-rbac-abac-rebac.md section 4.2;
 * core.legal_entities in 03-database.md). Resolves through the existing
 * `tenant` definition: `tenant->owner` manages/views every company of the
 * tenant; admin/member/guest are per-company grants (guest = per-company
 * accountant grant). ADDITIVE (R2 WP-02): no existing permission references
 * company yet - see the `company` relations added on the finance resources
 * below. Object id is `<tenant_id>/<company_id>` like every tenant-scoped
 * object.
 *
 * LD-B63-FLOWMEM-1 (legal-entity access model): there is no per-user
 * legal-entity assignment table anywhere (iam_invitations.company_scope is
 * spec-only), so access is tenant-wide: every owner/admin/member of the
 * tenant may operate in every company of that tenant. That is expressed by
 * `tenant->view` (owner + admin + member), NOT by per-company `member`
 * tuples: nothing writes company#member, and fanning out one tuple per
 * (user, company) would need falcon-id to know companies and business to
 * know membership. Deriving it through the `tenant` edge written at company
 * creation (+ the business LegalEntityAuthzBackfillJob for older rows) makes
 * a joining member, a removed member and a company created later converge
 * with no extra writes. External seat-free members (tenant#guest) are NOT
 * covered: they only ever reach a company through company#guest.
 */
definition company {
    relation tenant: tenant
    relation admin: user
    relation member: user
    relation guest: user

    permission manage = admin + tenant->owner
    permission view = admin + member + guest + tenant->view
}

/**
 * branch - sub-unit of a company (23 section 4.2). Inherits both permissions
 * from its company.
 */
definition branch {
    relation company: company

    permission view = company->view
    permission manage = company->manage
}

/**
 * Role - Named collection of permissions
 * Roles are tenant-scoped
 */
definition role {
    // Which tenant this role belongs to
    relation tenant: tenant

    // Users who have this role. `user with active_elevation` is a JIT grant
    // (falcon-id JITAccessService): it passes only while check-time `now` <
    // expires_at; falcon-id supplies `now` on every check (pkg/spicedb
    // check_context.go).
    relation member: user | group#member | user with active_elevation

    // Permissions
    permission view = member + tenant->admin
    permission assign = tenant->admin
}

/**
 * Group - Collection of users for easier permission management
 * Groups can be nested (hierarchical)
 */
definition group {
    // Which tenant this group belongs to
    relation tenant: tenant

    // Direct members
    relation member: user | group#member

    // Group administrators
    relation admin: user

    // Parent group for hierarchy
    relation parent: group

    // Computed permissions
    permission view = member + admin + tenant->admin
    permission manage = admin + tenant->admin

    // Effective membership includes parent group members
    permission effective_member = member + parent->effective_member
}

/**
 * Organization - Business unit within a tenant
 * Supports hierarchical org structures (departments, teams, etc.)
 */
definition organization {
    // Which tenant this org belongs to
    relation tenant: tenant

    // Organization members with different roles
    relation owner: user
    relation manager: user
    relation member: user

    // Parent org for hierarchy
    relation parent: organization

    // Computed permissions
    permission admin = owner + manager + tenant->admin
    permission view = owner + manager + member + parent->view
    permission manage = owner + manager + parent->manage
}

/**
 * Module - ERP business module (CRM, HR, Finance, etc.)
 * Module-level permissions for coarse-grained access control
 */
definition module {
    // Which tenant this module belongs to
    relation tenant: tenant

    // Roles that can access this module
    relation viewer: role#member | user
    relation editor: role#member | user
    relation admin: role#member | user
    // Seat-free ESS/kiosk intake: never implies module view/edit or work-order access.
    relation maintenance_request_creator: role#member
    relation maintenance_request_reader: role#member
    // Company selection is reference-only; it never implies general Core view/edit.
    relation legal_entity_reader: role#member

    // Computed permissions
    permission view = viewer + editor + admin + tenant->admin
    permission edit = editor + admin + tenant->admin
    permission manage = admin + tenant->admin
    permission delete = admin + tenant->admin
    permission legal_entities_read = view + legal_entity_reader

    // Marketing granular resource:action permissions (D-71 schema-drift gate,
    // the product roadmap §4.5/§4.9 "S2 enforced for Marketing"). Each aliases the
    // module-level permission [RequirePermissionAttribute].MapActionToModulePermission
    // would fall back to for the same action (read->view, create/update/delete/
    // publish/use->edit, admin->manage), so flipping Authorization:marketing:EnforceS2
    // to true is a strictness change, not a behaviour change, once granted the
    // same way real per-resource relations would be modelled. Business repo
    // spec: the product specification §8.
    permission leads_admin = manage
    permission workflows_admin = manage
    permission forms_read = view
    permission forms_create = edit
    permission forms_update = edit
    permission forms_delete = edit
    permission landing_pages_read = view
    permission landing_pages_create = edit
    permission landing_pages_update = edit
    permission landing_pages_delete = edit
    permission landing_pages_publish = edit
    permission ads_read = view
    permission ads_create = edit
    permission ads_update = edit
    permission ads_delete = edit
    permission ads_admin = manage
    permission social_read = view
    permission social_create = edit
    permission social_update = edit
    permission social_delete = edit
    permission social_admin = manage
    permission domains_read = view
    permission domains_create = edit
    permission domains_update = edit
    permission domains_delete = edit
    permission domains_admin = manage
    permission consent_create = edit
    permission consent_delete = edit
    permission consent_admin = manage
    permission suppressions_read = view
    permission scoring_admin = manage
    permission channels_create = edit
    permission channels_delete = edit
    permission channels_admin = manage
    permission ab_tests_admin = manage
    permission analytics_create = edit
    permission settings_create = edit
    permission webhooks_admin = manage
    permission manual_mail_create = edit
    permission manual_mail_read = view
    permission ai_read = view
    permission ai_create = edit
    permission ai_use = edit

    // CRM granular resource:action permissions for OpportunityEstimate
    // (business OpportunityEstimatesController; the product roadmap §4.4 --
    // lightweight, non-fiscal estimate replacing CRM Quotes, whose fiscal
    // lifecycle moved to SD). Each aliases the module-level permission
    // [RequirePermissionAttribute].MapActionToModulePermission already falls
    // back to for the same action (read->view, create/update/delete->edit),
    // so this only makes the granular SpiceDB check resolvable; it does not
    // change what gets granted while Authorization:crm:EnforceS2 stays false.
    permission opportunity_estimates_read = view
    permission opportunity_estimates_create = edit
    permission opportunity_estimates_update = edit
    permission opportunity_estimates_delete = edit

    // R-HR (RHR-B3) granular resource:action permissions: business HrModule
    // registers the "payroll" manifest (runs:*, lines:adjust, settings:manage;
    // WP-16) and hr sgk_notifications:read/export (WP-12). Same aliasing rule as
    // the blocks above (read->view, every other action->edit), so defining them
    // is strictness-neutral while Authorization:{hr,payroll}:EnforceS2 is false.
    // The real payroll segregation of duties (calculator != approver) is enforced
    // by the business service + ck_payroll_runs_sod today; a payroll_run
    // definition with per-run relations is R-HR WP-20: payroll_run below, with
    // no business tuple writes yet (LD-B42-RHRB6-8: the handler and the DB CHECK stay
    // authoritative until Authorization:payroll:EnforceS2 flips).
    permission runs_read = view
    permission runs_create = edit
    permission runs_calculate = edit
    permission runs_submit = edit
    permission runs_approve = edit
    permission runs_reject = edit
    permission runs_post = edit
    permission runs_pay = edit
    permission runs_distribute = edit
    permission runs_export_compliance = edit
    permission lines_adjust = edit
    // R-HR RHR-B6 / WP-20: icra / nafaka orders and BES enrolments of a payroll run.
    permission deductions_read = view
    permission deductions_manage = edit
    permission sgk_notifications_read = view
    permission sgk_notifications_export = edit

    // PreAccounting granular resource:action permissions (R2, B20 follow-up;
    // business PreAccounting permission manifest, dump-permission-manifest.py).
    // Same aliasing rule as the blocks above: each resolves to the module-level
    // permission MapActionToModulePermission already falls back to (read->view,
    // manage->manage, every other action->edit), so defining them is a
    // strictness-neutral change until Authorization:preaccounting:EnforceS2 flips.
    // Hyphenated resources are defined further down in underscore form
    // (LD-B20-5). Service-only scopes are not user permissions and are
    // intentionally absent (LD-B19-2).
    permission audit_create = edit
    permission audit_delete = edit
    permission audit_read = view
    permission audit_update = edit
    permission reports_unlock = edit
    permission cari_archive = edit
    permission cari_create = edit
    permission cari_delete = edit
    permission cari_read = view
    permission cari_update = edit
    permission cheques_create = edit
    permission cheques_delete = edit
    permission cheques_read = view
    permission cheques_update = edit
    permission cheques_void = edit
    permission dashboard_create = edit
    permission dashboard_delete = edit
    permission dashboard_read = view
    permission dashboard_update = edit
    permission expenses_approve = edit
    permission expenses_create = edit
    permission expenses_delete = edit
    permission expenses_pay = edit
    permission expenses_read = view
    permission expenses_update = edit
    permission import_commit = edit
    permission import_create = edit
    permission import_delete = edit
    permission import_harvest = edit
    permission import_read = view
    permission import_update = edit
    permission inbox_create = edit
    permission inbox_delete = edit
    permission inbox_read = view
    permission inbox_respond = edit
    permission inbox_update = edit
    permission invoices_cancel = edit
    permission invoices_create = edit
    permission invoices_delete = edit
    permission invoices_issue = edit
    permission invoices_read = view
    permission invoices_requeue = edit
    permission invoices_send = edit
    permission invoices_update = edit
    permission payments_allocate = edit
    permission payments_create = edit
    permission payments_delete = edit
    permission payments_read = view
    permission payments_update = edit
    permission recurring_create = edit
    permission recurring_delete = edit
    permission recurring_read = view
    permission recurring_update = edit
    permission reports_create = edit
    permission reports_delete = edit
    permission reports_lock = edit
    permission reports_read = view
    permission reports_update = edit
    permission settings_delete = edit
    permission settings_edit = manage
    permission settings_read = view
    // PPSCM per-company production settings (R6 WP-09).
    permission settings_manage = manage
    // Bulk-job undo (b79 gapbe2): requester reverses their own finished import inside its undo window (jobs:jobs:undo).
    permission jobs_undo = edit
    permission settings_update = edit
    // e-SMM / e-MM vouchers (EDOC-X X2).
    permission vouchers_cancel = edit
    permission vouchers_create = edit
    permission vouchers_delete = edit
    permission vouchers_issue = edit
    permission vouchers_read = view
    permission vouchers_update = edit
    // Invoice objections / itiraz (LD-B37-IT).
    permission objections_create = edit
    permission objections_delete = edit
    permission objections_read = view
    permission objections_update = edit

    // Hyphenated-resource permissions of ALL business modules (LD-B20-5, B21).
    // Business permission strings keep their hyphens (role grants, JWT perms,
    // manifests); RequirePermissionAttribute and the drift dump map '-' -> '_'
    // for the SpiceDB name (Hexxlock.Shared SpiceDbPermissionName), so the
    // underscore forms are what is defined here. Same aliasing rule as above
    // (read->view, manage/admin->manage, anything else->edit; the odd action
    // manage-integrator falls to edit like MapActionToModulePermission does).
    permission accountant_export_create = edit
    permission accountant_export_delete = edit
    permission accountant_export_read = view
    permission accountant_export_retry = edit
    permission accountant_export_update = edit
    permission bank_accounts_create = edit
    permission bank_accounts_read = view
    permission bank_accounts_update = edit
    permission bank_import_create = edit
    permission bank_import_delete = edit
    permission bank_import_read = view
    permission bank_import_update = edit
    permission cash_bank_archive = edit
    permission cash_bank_create = edit
    permission cash_bank_delete = edit
    permission cash_bank_read = view
    permission cash_bank_update = edit
    permission chart_of_accounts_create = edit
    permission chart_of_accounts_delete = edit
    permission chart_of_accounts_read = view
    permission chart_of_accounts_update = edit
    permission credit_debit_notes_create = edit
    permission credit_debit_notes_delete = edit
    permission credit_debit_notes_read = view
    permission credit_debit_notes_update = edit
    permission edoc_credits_create = edit
    permission edoc_credits_delete = edit
    permission edoc_credits_manage = manage
    permission edoc_credits_read = view
    permission edoc_credits_update = edit
    permission edoc_despatches_read = view
    permission edoc_despatches_retry = edit
    permission engineering_changes_create = edit
    permission engineering_changes_read = view
    permission engineering_changes_update = edit
    permission inspection_plans_create = edit
    permission inspection_plans_read = view
    permission inspection_plans_update = edit
    permission kur_farki_create = edit
    permission kur_farki_delete = edit
    permission kur_farki_read = view
    permission kur_farki_update = edit
    permission period_close_read = view
    permission period_close_update = edit
    permission preventive_maintenance_create = edit
    permission preventive_maintenance_read = view
    permission preventive_maintenance_update = edit
    permission purchase_invoices_cancel = edit
    permission purchase_invoices_create = edit
    permission purchase_invoices_delete = edit
    permission purchase_invoices_pay = edit
    permission purchase_invoices_read = view
    permission purchase_invoices_update = edit
    permission saved_views_create = edit
    permission saved_views_delete = edit
    permission saved_views_read = view
    permission saved_views_update = edit
    permission settings_manage_integrator = edit
    // FLOW-8 (b62): HR offer approval is its own grant (was gated by offers_create); aliases manage like the other approve actions.
    permission offers_approve = manage
    // FLOW-3 (b61): park / retry / dismiss source events (SD, MM, PM, payroll, inventory hand-offs) the pre-accounting rules refused.
    permission source_events_manage = manage
    permission source_events_read = view

    // R4 commerce: granular resource_action permissions of Inventory, MM
    // (purchasing) and SD (sales) (B24 LD-B24-3). Same aliasing rule as above,
    // with the R4 stance that destructive/approval actions are manage-level:
    // read/view->view; create/update/submit/post/receive and similar->edit;
    // approve/reject/cancel/override/reverse/block/unblock/delete/terminate,
    // payment, recalculate and admin-style manage_* ->manage (SoD-relevant
    // approvals stay manage). Business permission strings are unchanged.
    permission abc_classification_read = view
    permission abc_classification_recalculate = edit
    permission abc_classification_update = edit
    permission ai_insights_read = view
    permission alerts_read = view
    permission analytics_delete = manage
    permission analytics_read = view
    permission approvals_create = edit
    permission approvals_delete = manage
    permission approvals_read = view
    permission approvals_update = edit
    permission batches_create = edit
    permission batches_delete = manage
    permission batches_read = view
    permission batches_update = edit
    permission billing_create = edit
    permission billing_delete = manage
    permission billing_post = edit
    permission billing_read = view
    permission billing_update = edit
    permission bom_assemble = edit
    permission bom_create = edit
    permission bom_delete = manage
    permission bom_read = view
    permission bom_update = edit
    // PPSCM standard costing (R6 WP-09). Release is manage-level and distinct from production settlement (D15 SoD).
    permission costing_read = view
    permission costing_run = edit
    permission costing_release = manage
    // PPSCM production settlement (R6 WP-18). Run is edit-level (D15): distinct from releasing standard costs (costing_release, manage).
    permission settlement_read = view
    permission settlement_run = edit
    // Reversing a completed settlement is manage-level (D15): a planner holding only settlement_run cannot undo a posted month.
    permission settlement_reverse = manage
    // D10: the material price / quantity variance split is read-level on top of settlement_read (the Buyume+ plan flag gates it separately).
