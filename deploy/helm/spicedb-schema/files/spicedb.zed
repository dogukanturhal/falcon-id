    // dealer-pool top-ups, reconcile report) is additionally gated to the internal ops
    // tenant by the gateway (EDOC_OPS_TENANT_ID); never customer-facing.
    permission credits_read = view
    permission credits_manage = manage
    permission credits_admin = manage
