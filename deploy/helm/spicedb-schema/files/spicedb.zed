    // Accounting (general ledger / e-Defter) granular resource:action permissions
    // (R3 WP-06; business AccountingModule.BuildPermissionManifest, spec 12 s8 + s13.18).
    // Same aliasing rule as the blocks above: read->view, create/update->edit, and the
    // workflow/close/approve/run actions->manage (SoD: a plain editor can draft but never
    // approve, reverse, close or generate). `settings_update` and `reports_read` are
    // already defined above. Ledger rows are never deleted, so no *_delete is declared
    // (accounts use `archive`). periods_reopen is deliberately NOT a module relation
    // grant: only the tenant admin/owner system roles pass it (spec 12 s8), a module
    // `admin` (the accounting manager) does not.
    permission accounts_read = view
    permission accounts_create = edit
    permission accounts_update = edit
    permission accounts_archive = manage
    permission journal_entries_read = view
    permission journal_entries_create = edit
    permission journal_entries_update = edit
    permission journal_entries_approve = manage
    permission journal_entries_reverse = manage
    permission periods_read = view
    permission periods_close = manage
    permission periods_reopen = tenant->admin + tenant->owner
    // core:legal_entities:set_default (R3 fu1): tenant admin/owner only, mirrors periods_reopen
    permission legal_entities_set_default = tenant->admin + tenant->owner
    // core:legal_entities:set_tax_identity: tenant admin/owner only (one-time tax identity of a tax-pending company)
    permission legal_entities_set_tax_identity = tenant->admin + tenant->owner
    // core:edoc:activate / core:edoc:deactivate: e-Donusum (e-Fatura/e-Arsiv) opt-in per company. Activate: tenant admin/owner; deactivation request: tenant owner only.
    permission edoc_activate = tenant->admin + tenant->owner
    permission edoc_deactivate = tenant->owner
    permission cost_centers_read = view
    permission cost_centers_create = edit
    permission cost_centers_update = edit
    permission reports_approve = manage
    permission fx_run = manage
    permission edefter_generate = manage
    permission edefter_submit = manage
