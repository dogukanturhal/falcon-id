//
// Example SpiceDB schema showing the shape Falcon-ID expects.
//
// Falcon-ID does not ship an authorisation model: the model belongs to the
// product being protected, not to the identity provider. This file exists so
// the migrate tool has something to apply and so the expected shape is
// documented. Replace it with your own.
//
// Apply with:
//   go run ./schema/migrate.go --schema-file schema/example.zed

definition user {}

definition tenant {
    relation member: user
    relation admin: user

    permission administer = admin
    permission view = member + admin
}

// A resource owned by a tenant. Permissions resolve through tenant
// membership, so a user's reach is bounded by the tenant they belong to.
definition document {
    relation tenant: tenant
    relation owner: user
    relation viewer: user

    permission edit = owner + tenant->administer
    permission view = viewer + owner + tenant->view
}
