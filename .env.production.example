# Falcon ID — Production Environment
# All values MUST be explicitly configured. No defaults are safe for production.

ENVIRONMENT=production
SERVICE_NAME=falcon-id
SERVICE_PORT=8010
LOG_LEVEL=info

# Database (use connection pooler like PgBouncer)
DATABASE_URL=postgres://falcon:CHANGEME@db.internal:5432/falcon_id?sslmode=require
CONTROL_PLANE_DATABASE_URL=postgres://falcon:CHANGEME@db.internal:5432/falcon_id_control?sslmode=require

# Redis (use Redis Sentinel or Cluster in production)
REDIS_URL=redis://:CHANGEME@redis.internal:6379/0

# JWT — MUST be a strong 256-bit secret
JWT_SECRET=CHANGEME_GENERATE_WITH_openssl_rand_base64_32
JWT_ISSUER=falcon-id

# Encryption
ENCRYPTION_KEY=CHANGEME_EXACTLY_32_CHARACTERS!!
TOKEN_HASH_SALT=CHANGEME_GENERATE_RANDOM_VALUE

# SMTP
SMTP_HOST=mail.hexxlock.com
SMTP_PORT=587
SMTP_FROM=noreply@falcon.hexxlock.com
SMTP_USE_TLS=true

# MFA
MFA_ISSUER=Falcon ID

# Frontend URL
FRONTEND_URL=https://app.hexxlock.com

# OAuth / OIDC
OAUTH_ISSUER=https://falcon.hexxlock.com

# Internal API Key — minimum 32 characters
INTERNAL_API_KEY=CHANGEME_GENERATE_STRONG_KEY

# Trusted Proxies (required in production for rate limiting)
TRUSTED_PROXIES=10.0.0.0/8

# OPA
OPA_DECISION_PATH=falcon/authz/allow
