# Falcon ID — local development settings.
# Copy to .env and adjust. Nothing here is a real credential; every value is
# a throwaway for a laptop. Production deployments must set their own secrets
# (the service refuses weak or missing ones when ENVIRONMENT is production).
ENVIRONMENT=development
SERVICE_NAME=falcon-id
SERVICE_PORT=8010
LOG_LEVEL=debug

# Postgres (docker compose service "postgres"; the second database is created
# by deploy/dev/initdb/01-control-plane.sql)
DATABASE_URL=postgres://falcon:falcon_dev@localhost:5432/falcon_id?sslmode=disable
CONTROL_PLANE_DATABASE_URL=postgres://falcon:falcon_dev@localhost:5432/falcon_id_control?sslmode=disable

# Redis (docker compose service "redis")
REDIS_URL=redis://localhost:6379/0

# SpiceDB (docker compose service "spicedb"). The authorization engine treats
# SpiceDB as its only decision source, so leave this on.
SPICEDB_ENABLED=true
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_TOKEN=falcon-dev-preshared-key
SPICEDB_INSECURE=true

# Secrets. JWT_SECRET is generated at start-up when ALLOW_AUTO_JWT_SECRET=true,
# which means tokens do not survive a restart. EMAIL_HASH_KEY is always
# required; the value below is a placeholder for local use only.
ALLOW_AUTO_JWT_SECRET=true
EMAIL_HASH_KEY=dev-only-email-hash-key-change-me-0001
JWT_ISSUER=falcon-id

# MFA
MFA_ISSUER=Falcon ID

# SMTP (use Mailpit or similar; nothing is sent unless something listens here)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=dev@falcon.local
SMTP_USE_TLS=false

# Frontend and OAuth issuer
FRONTEND_URL=http://localhost:3000
OAUTH_ISSUER=http://localhost:8010

# Service-to-service key for the /internal API (dev only, 32+ characters)
INTERNAL_API_KEY=dev-internal-key-minimum-32-characters-long

# Optional first admin, created at start-up when both are set. Pick your own.
# FALCON_ADMIN_EMAIL=admin@example.com
# FALCON_ADMIN_PASSWORD=
