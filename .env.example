# Falcon ID — Development Environment
ENVIRONMENT=development
SERVICE_NAME=falcon-id
SERVICE_PORT=8010
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://falcon:falcon_dev@localhost:5432/falcon_id?sslmode=disable
CONTROL_PLANE_DATABASE_URL=postgres://falcon:falcon_dev@localhost:5432/falcon_id_control?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (auto-generated in dev if ALLOW_AUTO_JWT_SECRET=true)
ALLOW_AUTO_JWT_SECRET=true
JWT_ISSUER=falcon-id

# Email-uniqueness hash key (required; dev value only)
EMAIL_HASH_KEY=dev-email-hash-key-minimum-32-characters

# Encryption key for secrets stored in the database (exactly 32 bytes; dev value only)
ENCRYPTION_KEY=dev-only-encryption-key-32bytes!

# SpiceDB (authorization). docker compose starts one with this key.
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_TOKEN=dev-spicedb-preshared-key
SPICEDB_INSECURE=true

# Outbound service-to-service client and operator-console client IDs. The server
# will not start without them; these dummy values are enough for local use.
SERVICE_CLIENT_ID=dev-service-client
SERVICE_CLIENT_SECRET=dev-service-client-secret-not-real
IAM_SERVICE_URL=http://localhost:8010
OPS_OPERATOR_EXCHANGE_CLIENT_IDS=dev-operator-client

# MFA
MFA_ISSUER=Falcon ID

# SMTP (dev — use Mailhog or similar)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=dev@falcon.local
SMTP_USE_TLS=false

# Frontend
FRONTEND_URL=http://localhost:3000

# OAuth Issuer
OAUTH_ISSUER=http://localhost:8010

# Internal API Key (dev only)
INTERNAL_API_KEY=dev-internal-key-minimum-32-characters-long

# Standalone quickstart: no HexxLock platform services (tenant-management etc.)
STANDALONE_MODE=true
