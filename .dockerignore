# Keep local env files, keys and VCS data out of the build context.
.env
.env.*
!.env.example
*.pem
*.key
*.secret
.git
.gitignore
.gitattributes

# Build and test artefacts.
bin/
dist/
build/
*.test
*.exe
*.out
coverage.html
**/testdata

# Editor detritus.
.idea/
.vscode/
*.swp
.DS_Store

# docs/docs.go is the generated Swagger package imported by cmd/routes.go,
# so docs/ itself must stay in the context; only the Markdown can go.
docs/*.md
k6/
